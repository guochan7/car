## STM32：uart_protocol.c

```c
#include "uart_protocol.h"
#include "motor.h"
#include <string.h>

#define UART_FRAME_LENGTH       6
#define COMMAND_TIMEOUT_TICKS   30
#define PWM_SCALE               40

static volatile u8 uart_rx_buf[UART_FRAME_LENGTH];
static volatile u8 uart_rx_index = 0;
static volatile u8 car_data[4];
static volatile u8 uart_frame_ready = 0;
static volatile u16 command_timeout = COMMAND_TIMEOUT_TICKS;

static int target_motor_a = 0;
static int target_motor_b = 0;

void USART2_Protocol_Init(u32 baudrate)
{
    GPIO_InitTypeDef gpio_init;
    USART_InitTypeDef usart_init;
    NVIC_InitTypeDef nvic_init;

    RCC_APB2PeriphClockCmd(
        RCC_APB2Periph_GPIOA | RCC_APB2Periph_AFIO,
        ENABLE);
    RCC_APB1PeriphClockCmd(RCC_APB1Periph_USART2, ENABLE);

    gpio_init.GPIO_Pin = GPIO_Pin_2;
    gpio_init.GPIO_Speed = GPIO_Speed_50MHz;
    gpio_init.GPIO_Mode = GPIO_Mode_AF_PP;
    GPIO_Init(GPIOA, &gpio_init);

    gpio_init.GPIO_Pin = GPIO_Pin_3;
    gpio_init.GPIO_Mode = GPIO_Mode_IN_FLOATING;
    GPIO_Init(GPIOA, &gpio_init);

    USART_StructInit(&usart_init);
    usart_init.USART_BaudRate = baudrate;
    usart_init.USART_WordLength = USART_WordLength_8b;
    usart_init.USART_StopBits = USART_StopBits_1;
    usart_init.USART_Parity = USART_Parity_No;
    usart_init.USART_HardwareFlowControl = USART_HardwareFlowControl_None;
    usart_init.USART_Mode = USART_Mode_Rx | USART_Mode_Tx;
    USART_Init(USART2, &usart_init);

    USART_ITConfig(USART2, USART_IT_RXNE, ENABLE);

    nvic_init.NVIC_IRQChannel = USART2_IRQn;
    nvic_init.NVIC_IRQChannelPreemptionPriority = 2;
    nvic_init.NVIC_IRQChannelSubPriority = 2;
    nvic_init.NVIC_IRQChannelCmd = ENABLE;
    NVIC_Init(&nvic_init);

    USART_Cmd(USART2, ENABLE);

    target_motor_a = 0;
    target_motor_b = 0;
    Set_Pwm(0, 0);
}

void USART2_IRQHandler(void)
{
    u8 receive_data;

    if (USART_GetITStatus(USART2, USART_IT_RXNE) == RESET) {
        return;
    }

    receive_data = (u8)USART_ReceiveData(USART2);

    if (uart_rx_index == 0) {
        if (receive_data == 0xFC) {
            uart_rx_buf[0] = receive_data;
            uart_rx_index = 1;
        }
        return;
    }

    /* 0xFC cannot occur in valid payload data, so it safely resynchronizes. */
    if (receive_data == 0xFC) {
        uart_rx_buf[0] = receive_data;
        uart_rx_index = 1;
        return;
    }

    uart_rx_buf[uart_rx_index] = receive_data;
    uart_rx_index++;

    if (uart_rx_index < UART_FRAME_LENGTH) {
        return;
    }

    uart_rx_index = 0;

    if ((uart_rx_buf[0] == 0xFC) &&
        (uart_rx_buf[5] == 0xFD) &&
        (uart_rx_buf[1] <= 1) &&
        (uart_rx_buf[2] <= 150) &&
        (uart_rx_buf[3] <= 1) &&
        (uart_rx_buf[4] <= 150)) {
        car_data[0] = uart_rx_buf[1];
        car_data[1] = uart_rx_buf[2];
        car_data[2] = uart_rx_buf[3];
        car_data[3] = uart_rx_buf[4];
        uart_frame_ready = 1;
        command_timeout = 0;
    }

    memset((void *)uart_rx_buf, 0, sizeof(uart_rx_buf));
}

void System_Control_10ms(void)
{
    u8 left_direction;
    u8 left_speed;
    u8 right_direction;
    u8 right_speed;

    if (uart_frame_ready) {
        __disable_irq();
        left_direction = car_data[0];
        left_speed = car_data[1];
        right_direction = car_data[2];
        right_speed = car_data[3];
        uart_frame_ready = 0;
        __enable_irq();

        target_motor_a = (int)left_speed;
        target_motor_b = (int)right_speed;

        if (left_direction == 1) {
            target_motor_a = -target_motor_a;
        }

        if (right_direction == 1) {
            target_motor_b = -target_motor_b;
        }
    }

    if (command_timeout < COMMAND_TIMEOUT_TICKS) {
        command_timeout++;
    } else {
        target_motor_a = 0;
        target_motor_b = 0;
    }

    Set_Pwm(target_motor_a * PWM_SCALE,
            target_motor_b * PWM_SCALE);
}
