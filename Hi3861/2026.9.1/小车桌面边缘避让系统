## STM32：motor.c

```c
#include "motor.h"

void Motor_Init(void)
{
    GPIO_InitTypeDef gpio;

    RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOB, ENABLE);

    gpio.GPIO_Pin = GPIO_Pin_14 | GPIO_Pin_13;
    gpio.GPIO_Mode = GPIO_Mode_Out_PP;
    gpio.GPIO_Speed = GPIO_Speed_50MHz;
    GPIO_Init(GPIOB, &gpio);

    AIN = 0;
    BIN = 0;
}

void PWM_Init(u16 arr, u16 psc)
{
    GPIO_InitTypeDef gpio;
    TIM_TimeBaseInitTypeDef time_base;
    TIM_OCInitTypeDef output_compare;

    Motor_Init();

    RCC_APB1PeriphClockCmd(RCC_APB1Periph_TIM4, ENABLE);
    RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOB, ENABLE);

    /* TIM4_CH1 = PB6, TIM4_CH2 = PB7. */
    gpio.GPIO_Pin = GPIO_Pin_6 | GPIO_Pin_7;
    gpio.GPIO_Mode = GPIO_Mode_AF_PP;
    gpio.GPIO_Speed = GPIO_Speed_50MHz;
    GPIO_Init(GPIOB, &gpio);

    TIM_TimeBaseStructInit(&time_base);
    time_base.TIM_Period = arr;
    time_base.TIM_Prescaler = psc;
    time_base.TIM_ClockDivision = TIM_CKD_DIV1;
    time_base.TIM_CounterMode = TIM_CounterMode_Up;
    TIM_TimeBaseInit(TIM4, &time_base);

    TIM_OCStructInit(&output_compare);
    output_compare.TIM_OCMode = TIM_OCMode_PWM1;
    output_compare.TIM_OutputState = TIM_OutputState_Enable;
    output_compare.TIM_Pulse = 0;
    output_compare.TIM_OCPolarity = TIM_OCPolarity_High;

    TIM_OC1Init(TIM4, &output_compare);
    TIM_OC2Init(TIM4, &output_compare);
    TIM_OC1PreloadConfig(TIM4, TIM_OCPreload_Enable);
    TIM_OC2PreloadConfig(TIM4, TIM_OCPreload_Enable);
    TIM_ARRPreloadConfig(TIM4, ENABLE);
    TIM_Cmd(TIM4, ENABLE);
}

u32 myabs(long int value)
{
    if (value < 0) {
        return (u32)(-value);
    }

    return (u32)value;
}

static int LimitMotorPwm(int pwm)
{
    if (pwm > MOTOR_PWM_MAX) {
        return MOTOR_PWM_MAX;
    }

    if (pwm < -MOTOR_PWM_MAX) {
        return -MOTOR_PWM_MAX;
    }

    return pwm;
}

void Set_Pwm(int motor_a, int motor_b)
{
    motor_a = LimitMotorPwm(motor_a);
    motor_b = LimitMotorPwm(motor_b);

    /* Course wiring maps motor B to TIM4_CH1/AIN. */
    if (motor_b >= 0) {
        AIN = 0;
        PWMA = myabs(motor_b);
    } else {
        AIN = 1;
        PWMA = MOTOR_PWM_MAX - myabs(motor_b);
    }

    /* Course wiring maps motor A to TIM4_CH2/BIN. */
    if (motor_a >= 0) {
        BIN = 0;
        PWMB = myabs(motor_a);
    } else {
        BIN = 1;
        PWMB = MOTOR_PWM_MAX - myabs(motor_a);
    }
}
