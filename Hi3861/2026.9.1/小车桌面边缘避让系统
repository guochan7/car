```c
#include <stdio.h>
#include <stdint.h>
#include <unistd.h>

#include "ohos_init.h"
#include "cmsis_os2.h"
#include "wifiiot_gpio.h"
#include "wifiiot_gpio_ex.h"
#include "wifiiot_uart.h"

#define LEFT_EDGE_SENSOR      WIFI_IOT_GPIO_IDX_5
#define RIGHT_EDGE_SENSOR     WIFI_IOT_GPIO_IDX_6

/* Change to VALUE0 when the sensors are active-low at an edge. */
#define EDGE_ACTIVE_LEVEL     WIFI_IOT_GPIO_VALUE1

#define CONTROL_PERIOD_US     20000
#define EDGE_CONFIRM_COUNT    3

/* One tick equals 20 ms. */
#define STOP_BEFORE_TURN_TICKS    10
#define BACKWARD_TICKS            20
#define TURN_TICKS                30
#define STOP_AFTER_TURN_TICKS      5

/* Protocol speed is restored by the STM32 side. */
#define FORWARD_SPEED          60
#define BACKWARD_SPEED        -50
#define TURN_SPEED             50

typedef enum {
    CAR_STATE_FORWARD = 0,
    CAR_STATE_STOP_AT_EDGE,
    CAR_STATE_BACK_FROM_EDGE,
    CAR_STATE_TURN,
    CAR_STATE_STOP_AFTER_TURN,
    CAR_STATE_FAULT_STOP
} CarState;

typedef enum {
    TURN_DIRECTION_LEFT = 0,
    TURN_DIRECTION_RIGHT
} TurnDirection;

static uint8_t uart_sendbuf[6];
static CarState car_state = CAR_STATE_FORWARD;
static TurnDirection pending_turn = TURN_DIRECTION_RIGHT;
static uint16_t state_ticks = 0;
static uint8_t left_edge_count = 0;
static uint8_t right_edge_count = 0;
static uint8_t both_edge_turn_toggle = 0;

static uint8_t EdgeSensor_Read(WifiIotGpioIdx gpio)
{
    WifiIotGpioValue value = WIFI_IOT_GPIO_VALUE0;

    /* Fail safe: a read failure is treated as an edge. */
    if (GpioGetInputVal(gpio, &value) != 0) {
        return 1;
    }

    return value == EDGE_ACTIVE_LEVEL;
}

static uint8_t EdgeConfirm(uint8_t edge_detected, uint8_t *counter)
{
    if (edge_detected) {
        if (*counter < EDGE_CONFIRM_COUNT) {
            (*counter)++;
        }
    } else {
        *counter = 0;
    }

    return *counter >= EDGE_CONFIRM_COUNT;
}

/*
 * Frame: FC | left direction | left speed |
 *        right direction | right speed | FD
 */
static void stm32motor_control(int motor_a, int motor_b)
{
    uint8_t left_direction;
    uint8_t right_direction;

    if (motor_a < 0) {
        left_direction = 1;
        motor_a = -motor_a;
    } else {
        left_direction = 0;
    }

    if (motor_b < 0) {
        right_direction = 1;
        motor_b = -motor_b;
    } else {
        right_direction = 0;
    }

    if (motor_a > 150) {
        motor_a = 150;
    }

    if (motor_b > 150) {
        motor_b = 150;
    }

    uart_sendbuf[0] = 0xFC;
    uart_sendbuf[1] = left_direction;
    uart_sendbuf[2] = (uint8_t)motor_a;
    uart_sendbuf[3] = right_direction;
    uart_sendbuf[4] = (uint8_t)motor_b;
    uart_sendbuf[5] = 0xFD;

    UartWrite(WIFI_IOT_UART_IDX_2,
              (unsigned char *)uart_sendbuf,
              sizeof(uart_sendbuf));
}

static void car_stop(void)
{
    stm32motor_control(0, 0);
}

static void car_forward(void)
{
    stm32motor_control(FORWARD_SPEED, FORWARD_SPEED);
}

static void car_backward(void)
{
    stm32motor_control(BACKWARD_SPEED, BACKWARD_SPEED);
}

static void car_turn_left(void)
{
    stm32motor_control(-TURN_SPEED, TURN_SPEED);
}

static void car_turn_right(void)
{
    stm32motor_control(TURN_SPEED, -TURN_SPEED);
}

static void SelectTurnDirection(uint8_t left_edge, uint8_t right_edge)
{
    if (left_edge && right_edge) {
        both_edge_turn_toggle = !both_edge_turn_toggle;
        pending_turn = both_edge_turn_toggle
            ? TURN_DIRECTION_RIGHT
            : TURN_DIRECTION_LEFT;
        printf("Both sensors detected an edge\r\n");
    } else if (left_edge) {
        pending_turn = TURN_DIRECTION_RIGHT;
        printf("Left edge: turn right\r\n");
    } else {
        pending_turn = TURN_DIRECTION_LEFT;
        printf("Right edge: turn left\r\n");
    }
}

static void edge_control_task(void *argument)
{
    uint8_t left_edge;
    uint8_t right_edge;

    (void)argument;

    car_stop();
    usleep(1000000);

    while (1) {
        left_edge = EdgeConfirm(
            EdgeSensor_Read(LEFT_EDGE_SENSOR),
            &left_edge_count);
        right_edge = EdgeConfirm(
            EdgeSensor_Read(RIGHT_EDGE_SENSOR),
            &right_edge_count);

        switch (car_state) {
            case CAR_STATE_FORWARD:
                if (left_edge || right_edge) {
                    SelectTurnDirection(left_edge, right_edge);
                    car_stop();
                    state_ticks = STOP_BEFORE_TURN_TICKS;
                    car_state = CAR_STATE_STOP_AT_EDGE;
                } else {
                    car_forward();
                }
                break;

            case CAR_STATE_STOP_AT_EDGE:
                car_stop();
                if (state_ticks > 0) {
                    state_ticks--;
                } else {
                    state_ticks = BACKWARD_TICKS;
                    car_state = CAR_STATE_BACK_FROM_EDGE;
                }
                break;

            case CAR_STATE_BACK_FROM_EDGE:
                car_backward();
                if (state_ticks > 0) {
                    state_ticks--;
                } else {
                    state_ticks = TURN_TICKS;
                    car_state = CAR_STATE_TURN;
                }
                break;

            case CAR_STATE_TURN:
                if (pending_turn == TURN_DIRECTION_LEFT) {
                    car_turn_left();
                } else {
                    car_turn_right();
                }

                if (state_ticks > 0) {
                    state_ticks--;
                } else {
                    car_stop();
                    state_ticks = STOP_AFTER_TURN_TICKS;
                    car_state = CAR_STATE_STOP_AFTER_TURN;
                }
                break;

            case CAR_STATE_STOP_AFTER_TURN:
                car_stop();
                if (state_ticks > 0) {
                    state_ticks--;
                } else {
                    left_edge_count = 0;
                    right_edge_count = 0;
                    car_state = CAR_STATE_FORWARD;
                    printf("Continue forward\r\n");
                }
                break;

            case CAR_STATE_FAULT_STOP:
            default:
                car_stop();
                break;
        }

        usleep(CONTROL_PERIOD_US);
    }
}

static void correspondence(void)
{
    WifiIotUartAttribute uart_attr2 = {
        .baudRate = 115200,
        .dataBits = 8,
        .stopBits = 1,
        .parity = 0
    };
    osThreadAttr_t attr = {0};

    GpioInit();
    GpioSetDir(LEFT_EDGE_SENSOR, WIFI_IOT_GPIO_DIR_IN);
    GpioSetDir(RIGHT_EDGE_SENSOR, WIFI_IOT_GPIO_DIR_IN);

    IoSetFunc(WIFI_IOT_IO_NAME_GPIO_11,
              WIFI_IOT_IO_FUNC_GPIO_11_UART2_TXD);
    IoSetFunc(WIFI_IOT_IO_NAME_GPIO_12,
              WIFI_IOT_IO_FUNC_GPIO_12_UART2_RXD);

    UartInit(WIFI_IOT_UART_IDX_2, &uart_attr2, NULL);

    attr.name = "edge_control";
    attr.stack_size = 1024 * 4;
    attr.priority = 25;

    if (osThreadNew(edge_control_task, NULL, &attr) == NULL) {
        printf("Failed to create edge control task\r\n");
        car_stop();
    }
}

APP_FEATURE_INIT(correspondence);
