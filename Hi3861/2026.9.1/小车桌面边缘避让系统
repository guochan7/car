#include "stm32f10x.h"
#include "sys.h"
#include "delay.h"
#include "qst_board_api.h"
#include "motor.h"
#include "uart_protocol.h"

int main(void)
{
    Stm32_Clock_Init(9);
    MY_NVIC_PriorityGroupConfig(2);

    /* Keep the original USART1 for board logging/debugging. */
    uart_init(115200);

    /* Keep the SWD download/debug interface enabled. */
    JTAG_Set(SWD_ENABLE);

    /* TIM4 PWM: 72 MHz / 10 / 7200 = 1 kHz. */
    PWM_Init(7199, 9);

    /* New Hi3861 communication link on PA2/PA3. */
    USART2_Protocol_Init(115200);

    /* Required by the original delay_ms implementation. */
    SysTick_Config(72000000u / 1000u);

    Set_Pwm(0, 0);

    while (1) {
        System_Control_10ms();
        delay_ms(10);
    }
}
