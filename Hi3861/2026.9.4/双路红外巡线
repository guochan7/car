控制器接口与状态。对应文件：[line_control.h](17.0_TwoSensor_LineFollowing/line_control.h)。

```c
#ifndef LINE_CONTROL_H
#define LINE_CONTROL_H
#include <stdint.h>

typedef enum {
    LINE_FORWARD = 0, LINE_LEFT, LINE_RIGHT,
    LINE_JUNCTION_WAIT, LINE_ROUTE_LEFT, LINE_ROUTE_RIGHT, LINE_JUNCTION_EXIT,
    LINE_STOP_SENSOR = 16, LINE_STOP_SONAR, LINE_STOP_OBSTACLE,
    LINE_STOP_AMBIGUOUS, LINE_STOP_WHITE_TIMEOUT,
    LINE_STOP_CORRECTION_TIMEOUT, LINE_STOP_RUN_TIMEOUT,
    LINE_STOP_TURN_TIMEOUT, LINE_STOP_EXIT_TIMEOUT
} LineReason;

typedef enum { ROUTE_FOLLOW, ROUTE_CONFIRM, ROUTE_TURN, ROUTE_EXIT } RoutePhase;

typedef struct {
    uint32_t nowUs;
    int sensorsValid;
    int leftBlack;
    int rightBlack;
    int sonarValid;
    float distanceCm;
    uint32_t sonarAgeUs;
} LineInput;

typedef struct { int left; int right; LineReason reason; } LineOutput;

typedef struct {
    uint32_t startUs;
    uint32_t stateSinceUs;
    unsigned int candidate;
    unsigned int count;
    unsigned int stable;
    int ready;
    LineReason latch;
    RoutePhase phase;
    unsigned int junctionCount;
    uint32_t phaseSinceUs;
    uint32_t captureSinceUs;
    uint32_t clearSinceUs;
    unsigned int captureStage;
    unsigned int captureSide;
} LineController;

void LineInit(LineController *controller, uint32_t nowUs);
LineOutput LineStep(LineController *controller, const LineInput *input);
#endif
```

## line_control.c

巡线和岔路状态机。对应文件：[line_control.c](17.0_TwoSensor_LineFollowing/line_control.c)。

```c
#include "line_control.h"
#include "line_config.h"

static LineOutput Stop(LineController *c, LineReason reason)
{
    LineOutput out = {0, 0, reason};
    c->latch = reason;
    return out;
}

void LineInit(LineController *c, uint32_t nowUs)
{
    c->startUs = nowUs;
    c->stateSinceUs = nowUs;
    c->candidate = 0U;
    c->count = 0U;
    c->stable = 0U;
    c->ready = 0;
    c->latch = LINE_FORWARD;
    c->phase = ROUTE_FOLLOW;
    c->junctionCount = 0U;
    c->phaseSinceUs = nowUs;
    c->captureSinceUs = nowUs;
    c->clearSinceUs = nowUs;
    c->captureStage = 0U;
    c->captureSide = 0U;
}

static LineOutput Hold(LineReason reason)
{
    LineOutput out = {0, 0, reason};
    return out;
}

/* Reacquisition is a heuristic: after a minimum turn, require stable single
 * black followed by stable white. White alone can also be tile, so this does
 * NOT prove branch identity. Keep the turn bounded and test with supervision.
 */
static LineOutput RouteTurn(LineController *c, const LineInput *in, unsigned int raw)
{
    LineOutput out = {-LINE_ROUTE_TURN_SPEED, LINE_ROUTE_TURN_SPEED, LINE_ROUTE_LEFT};
    uint32_t elapsed = (uint32_t)(in->nowUs - c->phaseSinceUs);
    if (elapsed >= LINE_ROUTE_MAX_TURN_US) {
        return Stop(c, LINE_STOP_TURN_TIMEOUT);
    }
    if (c->junctionCount == 2U) {
        out.left = LINE_ROUTE_TURN_SPEED;
        out.right = -LINE_ROUTE_TURN_SPEED;
        out.reason = LINE_ROUTE_RIGHT;
    }
    if (elapsed < LINE_ROUTE_MIN_TURN_US) { return out; }
    if (raw == 3U) {
        c->captureStage = 0U;
    } else if (raw == 1U || raw == 2U) {
        if (c->captureStage == 0U || c->captureStage == 3U || c->captureSide != raw) {
            c->captureStage = 1U;
            c->captureSide = raw;
            c->captureSinceUs = in->nowUs;
        } else if (c->captureStage == 1U &&
            (uint32_t)(in->nowUs - c->captureSinceUs) >= LINE_CAPTURE_BLACK_US) {
            c->captureStage = 2U;
        }
    } else if (c->captureStage == 2U) {
        c->captureStage = 3U;
        c->captureSinceUs = in->nowUs;
    } else if (c->captureStage == 3U) {
        /* Hold the heading while confirming white instead of rotating away. */
        if ((uint32_t)(in->nowUs - c->captureSinceUs) >= LINE_CAPTURE_WHITE_US) {
            c->phase = ROUTE_EXIT;
            c->phaseSinceUs = in->nowUs;
            c->clearSinceUs = in->nowUs;
            c->captureStage = 0U;
            c->stable = 0U;
            c->candidate = 0U;
            c->count = LINE_STABLE_SAMPLES;
            c->stateSinceUs = in->nowUs;
        }
        return Hold(LINE_JUNCTION_EXIT);
    } else {
        c->captureStage = 0U;
    }
    if (c->captureStage == 3U) { return Hold(LINE_JUNCTION_EXIT); }
    return out;
}

LineOutput LineStep(LineController *c, const LineInput *in)
{
    unsigned int raw;
    LineOutput out = {LINE_BASE_SPEED, LINE_BASE_SPEED, LINE_FORWARD};
    if (c->latch >= LINE_STOP_SENSOR) {
        return Stop(c, c->latch);
    }
    if (!in->sensorsValid) {
        return Stop(c, LINE_STOP_SENSOR);
    }
    /* NaN also fails this comparison. Never interpret missing echo as clear. */
    if (!in->sonarValid || !(in->distanceCm > 0.0f) ||
        in->sonarAgeUs > LINE_SONAR_MAX_AGE_US) {
        return Stop(c, LINE_STOP_SONAR);
    }
    if (in->distanceCm <= LINE_STOP_DISTANCE_CM) {
        return Stop(c, LINE_STOP_OBSTACLE);
    }
    if ((uint32_t)(in->nowUs - c->startUs) >= LINE_MAX_RUN_US) {
        return Stop(c, LINE_STOP_RUN_TIMEOUT);
    }
    raw = (in->leftBlack ? 1U : 0U) | (in->rightBlack ? 2U : 0U);
    if (c->phase == ROUTE_TURN) { return RouteTurn(c, in, raw); }
    if (c->phase == ROUTE_CONFIRM) {
        if (raw != 3U) {
            c->phase = ROUTE_FOLLOW;
            return Hold(LINE_JUNCTION_WAIT);
        }
        if ((uint32_t)(in->nowUs - c->phaseSinceUs) >= LINE_JUNCTION_CONFIRM_US) {
            ++c->junctionCount;
            c->phase = ROUTE_TURN;
            c->phaseSinceUs = in->nowUs;
            c->captureStage = 0U;
            return RouteTurn(c, in, raw);
        }
        return Hold(LINE_JUNCTION_WAIT);
    }
    if (c->phase == ROUTE_EXIT) {
        if ((uint32_t)(in->nowUs - c->phaseSinceUs) >= LINE_JUNCTION_EXIT_US) {
            return Stop(c, LINE_STOP_EXIT_TIMEOUT);
        }
        /* Never count repeated double-black while still leaving this junction. */
        if (raw == 3U) {
            c->captureStage = 0U;
            return Hold(LINE_JUNCTION_EXIT);
        }
        if (c->captureStage == 0U) {
            c->captureStage = 1U;
            c->clearSinceUs = in->nowUs;
        }
        if ((uint32_t)(in->nowUs - c->clearSinceUs) >= LINE_JUNCTION_CLEAR_US) {
            c->phase = ROUTE_FOLLOW;
        }
    }
    if (raw == 3U) {
        /* Starting on a bar is unsafe; after two turns, stop at any further bar.
         * Neither case is declared a verified finish.
         */
        if (!c->ready || c->junctionCount >= 2U) {
            return Stop(c, LINE_STOP_AMBIGUOUS);
        }
        c->phase = ROUTE_CONFIRM;
        c->phaseSinceUs = in->nowUs;
        return Hold(LINE_JUNCTION_WAIT);
    }
    if (raw != c->candidate) {
        c->candidate = raw;
        c->count = 1U;
    } else if (c->count < LINE_STABLE_SAMPLES) {
        ++c->count;
    }
    if (c->count >= LINE_STABLE_SAMPLES && (!c->ready || c->stable != raw)) {
        c->stable = raw;
        c->stateSinceUs = in->nowUs;
        c->ready = 1;
    }
    if (c->stable == 0U) {
        if ((uint32_t)(in->nowUs - c->stateSinceUs) >= LINE_MAX_WHITE_US) {
            return Stop(c, LINE_STOP_WHITE_TIMEOUT);
        }
    } else {
        if ((uint32_t)(in->nowUs - c->stateSinceUs) >= LINE_MAX_CORRECTION_US) {
            return Stop(c, LINE_STOP_CORRECTION_TIMEOUT);
        }
        if (c->stable == 1U) {
            out.left = LINE_INNER_SPEED;
            out.right = LINE_OUTER_SPEED;
            out.reason = LINE_LEFT;
        } else {
            out.left = LINE_OUTER_SPEED;
            out.right = LINE_INNER_SPEED;
            out.reason = LINE_RIGHT;
        }
    }
    /* Wait stationary for the first stable reading. */
    if (!c->ready) {
        out.left = 0;
        out.right = 0;
    }
    return out;
}
