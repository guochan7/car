## LineFollowing.c

硬件接口与任务入口。对应文件：[LineFollowing.c](17.0_TwoSensor_LineFollowing/LineFollowing.c)。

```c
#include <stdio.h>
#include <stdint.h>
#include "ohos_init.h"
#include "cmsis_os2.h"
#include "hi_io.h"
#include "hi_time.h"
#include "hi_task.h"
#include "wifiiot_errno.h"
#include "wifiiot_gpio.h"
#include "wifiiot_gpio_ex.h"
#include "wifiiot_uart.h"
#include "line_config.h"
#include "line_control.h"

#define LEFT_GPIO       13
#define RIGHT_GPIO      14
#define TRIG_GPIO       7
#define ECHO_GPIO       8
#define SERVO_GPIO      2
#define LEFT_BLACK      WIFI_IOT_GPIO_VALUE0
#define RIGHT_BLACK     WIFI_IOT_GPIO_VALUE0
#define MOTOR_UART      WIFI_IOT_UART_IDX_2
#define SONAR_PERIOD_US 100000U
#define SONAR_TIMEOUT_US 12000U

/* Existing QST STM32 protocol. Success means sent, NOT motor acknowledgement. */
static unsigned int MotorWrite(int left, int right)
{
    uint8_t frame[6] = {0xFCU, 0U, 0U, 0U, 0U, 0xFDU};
    if (left < 0) { frame[1] = 1U; left = -left; }
    if (right < 0) { frame[3] = 1U; right = -right; }
    if (left > 150) { left = 150; }
    if (right > 150) { right = 150; }
    frame[2] = (uint8_t)left;
    frame[4] = (uint8_t)right;
    return UartWrite(MOTOR_UART, frame, sizeof(frame));
}

static int ReadIR(int *left, int *right)
{
    WifiIotGpioValue l;
    WifiIotGpioValue r;
    if (GpioGetInputVal(LEFT_GPIO, &l) != WIFI_IOT_SUCCESS ||
        GpioGetInputVal(RIGHT_GPIO, &r) != WIFI_IOT_SUCCESS) {
        return 0;
    }
    *left = (l == LEFT_BLACK);
    *right = (r == RIGHT_BLACK);
    return 1;
}

/* Single bounded measurement: at most about 24 ms plus API/scheduling cost.
 * Called every 100 ms, not three consecutive readings in the steering loop.
 * The sensor must face forward; 1500 us is a starting calibration only.
 */
static float FrontDistance(void)
{
    WifiIotGpioValue echo;
    uint32_t start;
    uint32_t pulse;
    float cm;
    if (GpioGetInputVal(ECHO_GPIO, &echo) != WIFI_IOT_SUCCESS ||
        echo != WIFI_IOT_GPIO_VALUE0) { return -1.0f; }
    if (GpioSetOutputVal(TRIG_GPIO, WIFI_IOT_GPIO_VALUE0) != WIFI_IOT_SUCCESS) {
        return -1.0f;
    }
    hi_udelay(2U);
    if (GpioSetOutputVal(TRIG_GPIO, WIFI_IOT_GPIO_VALUE1) != WIFI_IOT_SUCCESS) {
        return -1.0f;
    }
    hi_udelay(10U);
    if (GpioSetOutputVal(TRIG_GPIO, WIFI_IOT_GPIO_VALUE0) != WIFI_IOT_SUCCESS) {
        return -1.0f;
    }
    start = hi_get_us();
    do {
        if (GpioGetInputVal(ECHO_GPIO, &echo) != WIFI_IOT_SUCCESS ||
            (uint32_t)(hi_get_us() - start) >= SONAR_TIMEOUT_US) {
            return -1.0f;
        }
    } while (echo == WIFI_IOT_GPIO_VALUE0);
    pulse = hi_get_us();
    do {
        if (GpioGetInputVal(ECHO_GPIO, &echo) != WIFI_IOT_SUCCESS ||
            (uint32_t)(hi_get_us() - pulse) >= SONAR_TIMEOUT_US) {
            return -1.0f;
        }
    } while (echo == WIFI_IOT_GPIO_VALUE1);
    cm = (float)(uint32_t)(hi_get_us() - pulse) * 0.017f;
    /* Pulses below the usable range are invalid, hence stop. */
    return (cm >= 2.0f && cm <= 200.0f) ? cm : -1.0f;
}

#define CHECK(call) do { unsigned int rc = (call); \
    if (rc != WIFI_IOT_SUCCESS) { return rc; } } while (0)

static unsigned int HardwareInit(void)
{
    WifiIotUartAttribute uart = {
        .baudRate = 115200U, .dataBits = 8, .stopBits = 1, .parity = 0
    };
    unsigned int i;
    CHECK(GpioInit());
    CHECK(IoSetFunc(WIFI_IOT_IO_NAME_GPIO_11, WIFI_IOT_IO_FUNC_GPIO_11_UART2_TXD));
    CHECK(IoSetFunc(WIFI_IOT_IO_NAME_GPIO_12, WIFI_IOT_IO_FUNC_GPIO_12_UART2_RXD));
    CHECK(UartInit(MOTOR_UART, &uart, NULL));
    CHECK(MotorWrite(0, 0));
    CHECK(IoSetFunc(WIFI_IOT_IO_NAME_GPIO_13, WIFI_IOT_IO_FUNC_GPIO_13_GPIO));
    CHECK(IoSetFunc(WIFI_IOT_IO_NAME_GPIO_14, WIFI_IOT_IO_FUNC_GPIO_14_GPIO));
    CHECK(GpioSetDir(LEFT_GPIO, WIFI_IOT_GPIO_DIR_IN));
    CHECK(GpioSetDir(RIGHT_GPIO, WIFI_IOT_GPIO_DIR_IN));
    CHECK(IoSetFunc(WIFI_IOT_IO_NAME_GPIO_7, WIFI_IOT_IO_FUNC_GPIO_7_GPIO));
    CHECK(IoSetFunc(WIFI_IOT_IO_NAME_GPIO_8, WIFI_IOT_IO_FUNC_GPIO_8_GPIO));
    CHECK(GpioSetDir(TRIG_GPIO, WIFI_IOT_GPIO_DIR_OUT));
    CHECK(GpioSetDir(ECHO_GPIO, WIFI_IOT_GPIO_DIR_IN));
    CHECK(GpioSetOutputVal(TRIG_GPIO, WIFI_IOT_GPIO_VALUE0));
    CHECK(IoSetFunc(WIFI_IOT_IO_NAME_GPIO_2, WIFI_IOT_IO_FUNC_GPIO_2_GPIO));
    CHECK(GpioSetDir(SERVO_GPIO, WIFI_IOT_GPIO_DIR_OUT));
    for (i = 0U; i < 15U; ++i) {
        CHECK(GpioSetOutputVal(SERVO_GPIO, WIFI_IOT_GPIO_VALUE1));
        hi_udelay(1500U);
        CHECK(GpioSetOutputVal(SERVO_GPIO, WIFI_IOT_GPIO_VALUE0));
        hi_udelay(18500U);
    }
    return WIFI_IOT_SUCCESS;
}

static void LineTask(void *argument)
{
    LineController controller;
    LineInput input = {0};
    LineOutput output = {0, 0, LINE_FORWARD};
    uint32_t sonarStart;
    uint32_t logTime;
    int uartFault = 0;
    int lastReason = -1;
    unsigned int lastJunction = 0U;
    (void)argument;
    printf("[line] motors=%d; 3 second start delay\r\n", LINE_MOTORS_ENABLED);
    (void)MotorWrite(0, 0);
    hi_sleep(3000U);
    LineInit(&controller, hi_get_us());
    sonarStart = hi_get_us() - SONAR_PERIOD_US;
    logTime = hi_get_us() - 500000U;
    for (;;) {
        input.nowUs = hi_get_us();
        /* Stop is latched until reboot; do not resume when an obstacle moves. */
        if (uartFault || (LINE_MOTORS_ENABLED && output.reason >= LINE_STOP_SENSOR)) {
            (void)MotorWrite(0, 0);
            hi_sleep(100U);
            continue;
        }
        if ((uint32_t)(input.nowUs - sonarStart) >= SONAR_PERIOD_US) {
            sonarStart = hi_get_us();
            input.distanceCm = FrontDistance();
            input.sonarValid = (input.distanceCm > 0.0f);
        }
        input.sensorsValid = ReadIR(&input.leftBlack, &input.rightBlack);
        input.nowUs = hi_get_us();
        input.sonarAgeUs = (uint32_t)(input.nowUs - sonarStart);
        if (LINE_MOTORS_ENABLED) {
            output = LineStep(&controller, &input);
        }
        if (MotorWrite(output.left, output.right) != WIFI_IOT_SUCCESS) {
            uartFault = 1;
            (void)MotorWrite(0, 0);
            printf("[line] UART ERROR: physically switch motor power off\r\n");
        }
        if ((uint32_t)(input.nowUs - logTime) >= 500000U ||
            (int)output.reason != lastReason || controller.junctionCount != lastJunction) {
            logTime = input.nowUs;
            lastReason = (int)output.reason;
            lastJunction = controller.junctionCount;
            printf("[line] valid=%d black L=%d R=%d cm=%.1f wheels=%d,%d reason=%d junction=%u phase=%d\r\n",
                input.sensorsValid, input.leftBlack, input.rightBlack,
                input.distanceCm, output.left, output.right, (int)output.reason,
                controller.junctionCount, (int)controller.phase);
        }
        hi_sleep(10U);
    }
}

static void LineEntry(void)
{
    osThreadAttr_t attr = {
        .name = "TwoSensorLine", .attr_bits = 0U,
        .cb_mem = NULL, .cb_size = 0U, .stack_mem = NULL,
        .stack_size = 4096U, .priority = 25
    };
    unsigned int rc = HardwareInit();
    if (rc != WIFI_IOT_SUCCESS) {
        (void)MotorWrite(0, 0);
        printf("[line] init failed=%u; switch motor power off\r\n", rc);
        return;
    }
    if (osThreadNew(LineTask, NULL, &attr) == NULL) {
        (void)MotorWrite(0, 0);
        printf("[line] task creation failed\r\n");
    }
}
APP_FEATURE_INIT(LineEntry);
