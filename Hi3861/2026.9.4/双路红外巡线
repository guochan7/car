#ifndef LINE_CONFIG_H
#define LINE_CONFIG_H

/* First flash is a stationary sensor check. Set to 1 only after bench tests. */
#define LINE_MOTORS_ENABLED       0
#define LINE_BASE_SPEED           45
#define LINE_INNER_SPEED          20
#define LINE_OUTER_SPEED          55
#define LINE_STOP_DISTANCE_CM     25.0f
#define LINE_SONAR_MAX_AGE_US      250000U
#define LINE_MAX_RUN_US           10000000U
/* Heuristics, NOT reliable lost-line detectors. May stop on a valid straight. */
#define LINE_MAX_WHITE_US         4000000U
#define LINE_MAX_CORRECTION_US    1000000U
#define LINE_STABLE_SAMPLES       3U

/* Experimental route: first confirmed junction LEFT, second RIGHT.
 * Durations are test starting points, not calibrated turn angles.
 */
#define LINE_JUNCTION_CONFIRM_US  30000U
#define LINE_ROUTE_TURN_SPEED     35
#define LINE_ROUTE_MIN_TURN_US    120000U
#define LINE_ROUTE_MAX_TURN_US    1500000U
#define LINE_CAPTURE_BLACK_US     30000U
#define LINE_CAPTURE_WHITE_US     80000U
#define LINE_JUNCTION_CLEAR_US   300000U
#define LINE_JUNCTION_EXIT_US   1500000U

#endif
