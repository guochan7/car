```c
#include <assert.h>
#include <stdio.h>
#include "line_control.h"
#include "line_config.h"

static LineInput ClearInput(uint32_t now)
{
    LineInput in = {0};
    in.nowUs = now;
    in.sensorsValid = 1;
    in.sonarValid = 1;
    in.distanceCm = 100.0f;
    return in;
}

static LineOutput Stable(LineController *c, LineInput *in, int l, int r)
{
    unsigned int i;
    LineOutput out = {0};
    in->leftBlack = l;
    in->rightBlack = r;
    for (i = 0U; i < LINE_STABLE_SAMPLES; ++i) {
        in->nowUs += 10000U;
        out = LineStep(c, in);
    }
    return out;
}

static LineOutput ConfirmJunction(LineController *c, LineInput *in)
{
    LineOutput out;
    unsigned int oldCount = c->junctionCount;
    in->leftBlack = 1; in->rightBlack = 1; in->nowUs += 10000U;
    out = LineStep(c, in);
    assert(out.left == 0 && out.right == 0 && out.reason == LINE_JUNCTION_WAIT);
    assert(c->junctionCount == oldCount);
    in->nowUs += LINE_JUNCTION_CONFIRM_US;
    out = LineStep(c, in);
    assert(c->junctionCount == oldCount + 1U);
    return out;
}

static void CaptureAndExit(LineController *c, LineInput *in)
{
    unsigned int count = c->junctionCount;
    LineOutput out;
    in->nowUs += LINE_ROUTE_MIN_TURN_US;
    in->leftBlack = 1; in->rightBlack = 0;
    (void)LineStep(c, in);
    in->nowUs += LINE_CAPTURE_BLACK_US;
    (void)LineStep(c, in);
    in->leftBlack = 0; in->nowUs += 10000U;
    out = LineStep(c, in);
    assert(out.left == 0 && out.right == 0);
    in->nowUs += LINE_CAPTURE_WHITE_US;
    (void)LineStep(c, in);
    assert(c->phase == ROUTE_EXIT);
    /* Same-junction bounce must not consume the second planned turn. */
    in->leftBlack = 1; in->rightBlack = 1; in->nowUs += 10000U;
    out = LineStep(c, in);
    assert(out.left == 0 && out.right == 0 && c->junctionCount == count);
    in->leftBlack = 0; in->rightBlack = 0; in->nowUs += 10000U;
    (void)LineStep(c, in);
    in->nowUs += LINE_JUNCTION_CLEAR_US;
    (void)LineStep(c, in);
    assert(c->phase == ROUTE_FOLLOW && c->junctionCount == count);
}

static void TestRoute(void)
{
    LineController c;
    LineInput in = ClearInput(0U);
    LineOutput out;
    LineInit(&c, 0U);
    (void)Stable(&c, &in, 0, 0);
    /* A brief double-black stops temporarily but is not counted. */
    in.leftBlack = 1; in.rightBlack = 1; in.nowUs += 10000U;
    (void)LineStep(&c, &in);
    in.leftBlack = 0; in.rightBlack = 0; in.nowUs += 10000U;
    (void)LineStep(&c, &in);
    assert(c.junctionCount == 0U && c.phase == ROUTE_FOLLOW);
    out = ConfirmJunction(&c, &in);
    assert(out.reason == LINE_ROUTE_LEFT && out.left < 0 && out.right > 0);
    CaptureAndExit(&c, &in);
    out = ConfirmJunction(&c, &in);
    assert(out.reason == LINE_ROUTE_RIGHT && out.left > 0 && out.right < 0);
    CaptureAndExit(&c, &in);
    in.leftBlack = 1; in.rightBlack = 1;
    assert(LineStep(&c, &in).reason == LINE_STOP_AMBIGUOUS);
    assert(c.junctionCount == 2U);

    /* White alone during a turn must NOT declare successful reacquisition. */
    in = ClearInput(0U); LineInit(&c, 0U);
    (void)Stable(&c, &in, 0, 0);
    (void)ConfirmJunction(&c, &in);
    in.leftBlack = 0; in.rightBlack = 0;
    in.nowUs += LINE_ROUTE_MIN_TURN_US + LINE_CAPTURE_WHITE_US;
    (void)LineStep(&c, &in);
    assert(c.phase == ROUTE_TURN);
    in.nowUs = c.phaseSinceUs + LINE_ROUTE_MAX_TURN_US;
    assert(LineStep(&c, &in).reason == LINE_STOP_TURN_TIMEOUT);

    /* A stuck double-black cannot increment count repeatedly. */
    in = ClearInput(0U); LineInit(&c, 0U);
    (void)Stable(&c, &in, 0, 0);
    (void)ConfirmJunction(&c, &in);
    in.nowUs += LINE_ROUTE_MAX_TURN_US;
    assert(LineStep(&c, &in).reason == LINE_STOP_TURN_TIMEOUT);
    assert(c.junctionCount == 1U);

    /* Obstacle checking overrides even an active route turn. */
    in = ClearInput(0U); LineInit(&c, 0U);
    (void)Stable(&c, &in, 0, 0);
    (void)ConfirmJunction(&c, &in);
    in.distanceCm = 10.0f;
    assert(LineStep(&c, &in).reason == LINE_STOP_OBSTACLE);

    /* Route timing also works over the microsecond timer wrap. */
    in = ClearInput(UINT32_MAX - 10000U); LineInit(&c, in.nowUs);
    (void)Stable(&c, &in, 0, 0);
    assert(ConfirmJunction(&c, &in).reason == LINE_ROUTE_LEFT);
    CaptureAndExit(&c, &in);
}

int main(void)
{
    LineController c;
    LineInput in = ClearInput(0U);
    LineOutput out;
    LineInit(&c, 0U);
    out = LineStep(&c, &in);
    assert(out.left == 0 && out.right == 0);
    out = Stable(&c, &in, 0, 0);
    assert(out.reason == LINE_FORWARD && out.left == out.right && out.left > 0);
    out = Stable(&c, &in, 1, 0);
    assert(out.reason == LINE_LEFT && out.left < out.right);
    out = Stable(&c, &in, 0, 1);
    assert(out.reason == LINE_RIGHT && out.left > out.right);
    out = Stable(&c, &in, 0, 0);
    assert(out.reason == LINE_FORWARD);

    /* Starting directly on a black bar remains a latched stop. */
    LineInit(&c, in.nowUs);
    in.leftBlack = 1; in.rightBlack = 1;
    out = LineStep(&c, &in);
    assert(out.reason == LINE_STOP_AMBIGUOUS && out.left == 0 && out.right == 0);
    in.leftBlack = 0; in.rightBlack = 0;
    assert(LineStep(&c, &in).reason == LINE_STOP_AMBIGUOUS);

    LineInit(&c, in.nowUs);
    in.distanceCm = LINE_STOP_DISTANCE_CM;
    assert(LineStep(&c, &in).reason == LINE_STOP_OBSTACLE);
    LineInit(&c, in.nowUs);
    in.distanceCm = 100.0f; in.sonarValid = 0;
    assert(LineStep(&c, &in).reason == LINE_STOP_SONAR);
    LineInit(&c, in.nowUs);
    in.sonarValid = 1; in.sonarAgeUs = LINE_SONAR_MAX_AGE_US + 1U;
    assert(LineStep(&c, &in).reason == LINE_STOP_SONAR);
    LineInit(&c, in.nowUs);
    in.sonarAgeUs = 0U; in.distanceCm = -1.0f;
    assert(LineStep(&c, &in).reason == LINE_STOP_SONAR);
    LineInit(&c, in.nowUs);
    in.distanceCm = 100.0f; in.sensorsValid = 0;
    assert(LineStep(&c, &in).reason == LINE_STOP_SENSOR);

    in = ClearInput(0U); LineInit(&c, 0U);
    (void)Stable(&c, &in, 0, 0);
    in.nowUs += LINE_MAX_WHITE_US;
    assert(LineStep(&c, &in).reason == LINE_STOP_WHITE_TIMEOUT);
    in = ClearInput(0U); LineInit(&c, 0U);
    (void)Stable(&c, &in, 1, 0);
    in.nowUs += LINE_MAX_CORRECTION_US;
    assert(LineStep(&c, &in).reason == LINE_STOP_CORRECTION_TIMEOUT);
    in = ClearInput(LINE_MAX_RUN_US); LineInit(&c, 0U);
    assert(LineStep(&c, &in).reason == LINE_STOP_RUN_TIMEOUT);

    /* A lone black sample must not flip steering. */
    in = ClearInput(0U); LineInit(&c, 0U);
    (void)Stable(&c, &in, 0, 0);
    in.leftBlack = 1; in.nowUs += 10000U;
    assert(LineStep(&c, &in).reason == LINE_FORWARD);
    in.leftBlack = 0; in.nowUs += 10000U;
    assert(LineStep(&c, &in).reason == LINE_FORWARD);

    /* Timer subtraction across the uint32 microsecond wrap. */
    in = ClearInput(UINT32_MAX - 10000U); LineInit(&c, in.nowUs);
    out = Stable(&c, &in, 0, 0);
    assert(out.reason == LINE_FORWARD && out.left > 0);
    in.nowUs += LINE_MAX_WHITE_US;
    assert(LineStep(&c, &in).reason == LINE_STOP_WHITE_TIMEOUT);
    TestRoute();
    puts("line_control tests passed");
    return 0;
}
