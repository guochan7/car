## `I2c_Ssd1306.c`

```c
#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <unistd.h>

#include "ohos_init.h"
#include "cmsis_os2.h"
#include "hal_bsp_ssd1306.h"

static void Task1(void *argument)
{
    (void)argument;

    uint8_t displayBuff[20] = {0};
    uint8_t hour = 16;
    uint8_t min = 0;
    uint8_t sec = 0;

    SSD1306_Init();
    SSD1306_CLS();
    SSD1306_ShowStr(0, 0, (uint8_t *)"    QST CAR    ", 16);
    SSD1306_ShowStr(0, 3, (uint8_t *)"2025:10:08", 16);

    while (1)
    {
        sec++;

        if (sec > 59)
        {
            sec = 0;
            min++;
        }

        if (min > 59)
        {
            min = 0;
            hour++;
        }

        if (hour > 23)
        {
            hour = 0;
        }

        memset(displayBuff, 0, sizeof(displayBuff));
        snprintf((char *)displayBuff,
                 sizeof(displayBuff),
                 "%02d:%02d:%02d",
                 hour,
                 min,
                 sec);

        SSD1306_ShowStr(0, 2, displayBuff, 16);
        sleep(1);
    }
}

static void i2c_ssd1306_demo(void)
{
    osThreadAttr_t options = {0};

    options.name = "thread_1";
    options.stack_size = 1024;
    options.priority = osPriorityNormal;

    osThreadId_t task1Id = osThreadNew(Task1, NULL, &options);

    if (task1Id == NULL)
    {
        printf("Failed to create Task1.\r\n");
    }
    else
    {
        printf("Task1 created successfully.\r\n");
    }
}

APP_FEATURE_INIT(i2c_ssd1306_demo);
```

